# App Settings

# Local development
APP_UID=blazorshorturl
BUILD_PLATFORM=Linux
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://+:7100;http://+:5100
BASE_ADDRESS=https://localhost:7100
LOG_LEVEL=Information

# Production (Docker container)
# BASE_ADDRESS needed for API calls to IdentityController
# APP_UID=blazorshorturl
# BUILD_PLATFORM=Linux
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# ASPNETCORE_URLS=https://+:7100;http://+:5100
# BASE_ADDRESS=http://your_domain.com:7100
# LOG_LEVEL=Information


# uuidgen on macos to create development SSL certificate
CREDENTIAL_PLACEHOLDER=uuidgen_ssl_key

ADMIN_EMAIL=username@domain.com
ADMIN_PASSWORD=your_admin_password
API_KEY=your_uuidgen_api_key

# ConnectionStrings for EF Core Migrations
# AppDbContext=Server=mssql_ip_address;Database=db_name;User Id=sa_user;Password=sa_password;TrustServerCertificate=true;Connection Timeout=30;
# DataContext=Server=mssql_ip_address;Database=db_name;User Id=sa_user;Password=sa_password;TrustServerCertificate=true;Connection Timeout=30;

# ConnectionStrings for application
AppDbContext=Server=mssql_ip_address;Database=db_name;User Id=db_user;Password=db_password;TrustServerCertificate=true;Connection Timeout=30;
DataContext=Server=mssql_ip_address;Database=db_name;User Id=db_user;Password=db_password;TrustServerCertificate=true;Connection Timeout=30;
