    "version": "0.2.0",
    "configurations": [
        {
            "name": "Containers: .NET Container SDK",
            "type": "docker",
            "request": "launch",
            "netCore": {
                "appProject": "${workspaceFolder}/BlazorShortUrl.csproj",
                "buildWithSdk": true
            }
        },
        {
            "name": "Containers: .NET Launch",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "netCore": {
                "appProject": "${workspaceFolder}/BlazorShortUrl.csproj"
            }
        },
        {
            "name": "C#: BlazorShortUrl [https]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/BlazorShortUrl.csproj",
            "launchConfigurationId": "TargetFramework=;https"
        },
        {
            "name": "C#: BlazorShortUrl [http]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/BlazorShortUrl.csproj",
            "launchConfigurationId": "TargetFramework=;http"
        },
    ]
}